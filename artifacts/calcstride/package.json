{
  "name": "@workspace/calcstride",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "generate:seo": "tsx scripts/generate-seo-files.ts",
    "build:client": "vite build --config vite.config.ts",
    "build:ssr": "vite build --config vite.config.ts --ssr src/entry-server.tsx",
    "build:runtime": "vite build --config vite.production-server.config.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run generate:seo && pnpm run build:client && pnpm run build:ssr && pnpm run build:runtime && tsx scripts/prerender.ts",
    "audit:seo": "tsx scripts/audit-built-site.ts",
    "audit:static": "tsx scripts/audit-built-site.ts",
    "build:static": "pnpm run build && pnpm run audit:static",
    "audit:production-responses": "tsx scripts/audit-production-responses.ts",
    "audit:production-timings": "tsx scripts/audit-production-server-timings.ts",
    "serve:production": "node dist/runtime/production-server.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/lib/*.test.ts"
  },
  "devDependencies": {
