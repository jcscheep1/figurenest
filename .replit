modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[[deployment.responseHeaders]]
path = "/*"
name = "Content-Security-Policy"
value = "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://pagead2.googlesyndication.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.clarity.ms https://*.bing.com; img-src 'self' data: https://*.google-analytics.com https://*.googlesyndication.com https://*.clarity.ms https://*.bing.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://googleads.g.doubleclick.net https://*.googlesyndication.com; manifest-src 'self'; upgrade-insecure-requests"

[[deployment.responseHeaders]]
path = "/*"
name = "Permissions-Policy"
value = "camera=(), geolocation=(), microphone=()"

[[deployment.responseHeaders]]
path = "/*"
name = "Referrer-Policy"
value = "strict-origin-when-cross-origin"

[[deployment.responseHeaders]]
path = "/*"
name = "Strict-Transport-Security"
value = "max-age=63072000; includeSubDomains"

[[deployment.responseHeaders]]
path = "/*"
name = "X-Content-Type-Options"
value = "nosniff"

[[deployment.responseHeaders]]
path = "/*"
name = "X-Frame-Options"
value = "DENY"

[[deployment.responseHeaders]]
path = "/*"
name = "Cache-Control"
value = "public, max-age=60, s-maxage=300, stale-while-revalidate=86400"

[[deployment.responseHeaders]]
path = "/assets/*"
name = "Cache-Control"
value = "public, max-age=31536000, immutable"

[[deployment.responseHeaders]]
path = "/social/*"
name = "Cache-Control"
value = "public, max-age=604800, s-maxage=604800, stale-while-revalidate=2592000"

[[deployment.responseHeaders]]
path = "/pwa-*"
name = "Cache-Control"
value = "public, max-age=604800, s-maxage=604800, stale-while-revalidate=2592000"

[[deployment.responseHeaders]]
path = "/favicon.svg"
name = "Cache-Control"
value = "public, max-age=604800, s-maxage=604800, stale-while-revalidate=2592000"

[[deployment.responseHeaders]]
path = "/apple-touch-icon.png"
name = "Cache-Control"
value = "public, max-age=604800, s-maxage=604800, stale-while-revalidate=2592000"

[[deployment.responseHeaders]]
path = "/manifest.webmanifest"
name = "Cache-Control"
value = "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"

[[deployment.responseHeaders]]
path = "/service-worker.js"
name = "Cache-Control"
value = "no-cache, no-store, must-revalidate"

[[deployment.responseHeaders]]
path = "/sign-in"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/sign-in/*"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/sign-up"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/sign-up/*"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/account/*"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/admin/*"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/auth/*"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/internal/*"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/private/*"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/control-center"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/control-center/*"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/api"
name = "Cache-Control"
value = "private, no-store"

[[deployment.responseHeaders]]
path = "/api/*"
name = "Cache-Control"
value = "private, no-store"

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]

[nix]
channel = "stable-25_05"
